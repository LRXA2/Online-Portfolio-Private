---
const nodes = [{x:90,y:125,label:'Input 1'}, {x:90,y:305,label:'Input 2'}, {x:350,y:125,label:'Hidden 1'}, {x:350,y:305,label:'Hidden 2'}, {x:620,y:215,label:'Prediction'}];
const layouts = [
  { name: 'desktop', viewBox: '0 60 720 340', nodes },
  { name: 'mobile', viewBox: '0 0 420 590', nodes: nodes.map((node, index) => ({ ...node, x: [100,320,100,320,210][index], y: [80,80,290,290,490][index] })) },
];
const endpoint = (from: {x:number;y:number}, to: {x:number;y:number}, radius: number) => {
  const distance = Math.hypot(to.x-from.x, to.y-from.y);
  return {x: from.x + (to.x-from.x) / distance * radius, y: from.y + (to.y-from.y) / distance * radius};
};
const edges = [[0,2,0],[1,2,1],[0,3,2],[1,3,3],[2,4,6],[3,4,7]];
---
<div class="neural-training" data-phase="forward">
  <div class="network-canvas">
    {layouts.map(layout => <svg class={`network-${layout.name}`} viewBox={layout.viewBox} role="img" aria-label="Two inputs flow through two hidden neurons into a prediction; gradients return along the connections">
      {edges.map(([from,to,index]) => {
        const start = endpoint(layout.nodes[from],layout.nodes[to],42);
        const end = endpoint(layout.nodes[to],layout.nodes[from],42);
        const fraction = index === 1 ? .3 : index === 2 ? .7 : .5;
        return <g data-connection={index}>
          <line class="edge" x1={start.x} y1={start.y} x2={end.x} y2={end.y} />
          <circle class="signal" r="5" cx={start.x} cy={start.y} />
          <text class="edge-value" data-edge-value={index} x={layout.nodes[from].x+(layout.nodes[to].x-layout.nodes[from].x)*fraction} y={layout.nodes[from].y+(layout.nodes[to].y-layout.nodes[from].y)*fraction-10} text-anchor="middle"></text>
        </g>;
      })}
      {layout.nodes.map((node,index) => <g class="neuron"><circle cx={node.x} cy={node.y} r="40" /><text class="node-value" data-node={index} x={node.x} y={node.y+6} text-anchor="middle"></text><text class="node-label" x={node.x} y={node.y+65} text-anchor="middle">{node.label}</text></g>)}
    </svg>)}
  </div>
  <div class="network-result">
    <div class="prediction-meter"><div><span>Prediction <b data-prediction>0.516</b></span><span>Target 0.800</span></div><div class="meter-track"><span data-prediction-bar></span><i aria-hidden="true"></i></div></div>
    <div class="loss-value">Loss <strong data-loss>0.040328</strong></div>
    <div class="update-value">Updates <strong data-updates>0 / 3</strong></div>
  </div>
</div>
<style>
  .neural-training { --signal: var(--color-accent); }
  .network-canvas { max-width: 760px; margin: auto; background: radial-gradient(ellipse at 50% 50%, #d7a18410, transparent 70%); }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .network-mobile { display: none; }
  .edge { stroke: #666e60; stroke-width: 2; }
  .signal { fill: var(--signal); filter: drop-shadow(0 0 5px var(--signal)); }
  .edge-value { fill: var(--color-text-secondary); font: 14px var(--font-mono); paint-order: stroke; stroke: var(--color-bg-primary); stroke-width: 5px; }
  .neuron circle { fill: #242821; stroke: #b7b4a9; stroke-width: 1.5; }
  .node-value { fill: var(--color-text-primary); font: 17px var(--font-mono); }
  .node-label { fill: var(--color-text-secondary); font: 15px var(--font-mono); }
  [data-phase="backward"] { --signal: #b3c9a5; }
  [data-phase="backward"] .edge { stroke: #819575; }
  [data-phase="update"] .edge { stroke: var(--color-accent); }
  [data-phase="error"] .neuron:last-child circle { stroke: var(--color-accent); stroke-width: 3; }
  .network-result { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; align-items: center; padding: 1.2rem 0; border-top: 1px solid var(--line); font: var(--text-ui)/1.6 var(--font-mono); color: var(--color-text-secondary); }
  .prediction-meter > div:first-child { display: flex; justify-content: space-between; gap: 1rem; }
  b, strong { font-weight: 400; color: var(--color-accent); }
  .meter-track { position: relative; height: 7px; background: #34392f; margin-top: .8rem; }
  .meter-track span { display: block; height: 100%; background: var(--color-accent); }
  .meter-track i { position: absolute; height: 15px; top: -4px; left: 80%; border-left: 2px solid var(--color-text-primary); }
  .loss-value strong, .update-value strong { display: block; font-size: var(--text-lead); }
  @media(max-width: 600px) { .network-result { grid-template-columns: 1fr 1fr; gap: 1rem; } .prediction-meter { grid-column: 1/-1; } }
  @media(max-width: 500px) { .network-desktop { display: none; } .network-mobile { display: block; max-height: 410px; } .node-value { font-size: 25px; } .node-label { font-size: 23px; } .edge-value { display: none; } }
</style>