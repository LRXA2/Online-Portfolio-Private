---
import { certifications, type Certification } from '../data/certifications';

const providerGroups = new Map<string, Certification[]>();
for (const certification of certifications) {
  const group = providerGroups.get(certification.provider) ?? [];
  group.push(certification);
  providerGroups.set(certification.provider, group);
}
---
<section class="edu" id="education" aria-labelledby="education-title">
  <header class="edu-head">
    <span class="edu-kicker">CREDENTIALS</span>
    <h2 class="edu-title" id="education-title">Education &amp; <em>certifications.</em></h2>
  </header>

  <div class="edu-grid">
    <section class="edu-col" aria-labelledby="academic-heading">
      <h3 class="edu-col-label" id="academic-heading">Education</h3>
      <div class="edu-academic">
      <h4 class="edu-institution">Singapore Polytechnic</h4>
      <p class="edu-meta"><time datetime="2022-04">APR 2022</time> &mdash; <time datetime="2025-05">MAY 2025</time></p>
      <p class="edu-degree">Diploma in Applied AI &amp; Analytics</p>
      <div class="edu-additional">
        <p class="edu-meta">ADDITIONAL QUALIFICATION</p>
        <p class="edu-degree">Certification in IoT</p>
      </div>
      </div>
    </section>

    <section class="edu-col" aria-labelledby="certifications-heading">
      <h3 class="edu-col-label" id="certifications-heading">Professional certifications</h3>
      <div class="cert-scroll" role="region" aria-labelledby="certifications-heading" tabindex="0">
      {Array.from(providerGroups, ([provider, entries]) => (
        <div class="cert-group">
          <h4 class="cert-provider">{provider}</h4>
          <ul class="cert-list">
            {entries.map((certification) => (
              <li class="cert-row">
                {certification.link !== '#' ? (
                  <a class="cert-link" href={certification.link} target="_blank" rel="noopener noreferrer">
                    <span class="cert-name">{certification.name}</span>
                    <span class="cert-ext" aria-hidden="true">&#8599;</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : <span class="cert-name">{certification.name}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
      </div>
    </section>
  </div>
</section>

<style>
  .edu { padding: 4rem 0; overflow-wrap: anywhere; }
  .edu-head { margin-bottom: 2.5rem; }
  .edu-kicker {
    font: var(--text-meta)/1.6 var(--font-mono);
    letter-spacing: .18em;
    color: var(--color-accent);
  }
  .edu-title {
    margin: .75rem 0 0;
    font: 400 var(--text-section)/1.2 var(--font-display);
    color: var(--color-text-primary);
  }
  .edu-title em { color: var(--color-accent); }
  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: stretch;
  }
  .edu-col { min-width: 0; display: flex; flex-direction: column; }
  .edu-academic { flex: 1; display: grid; align-content: center; }
  .cert-scroll {
    max-height: 28rem;
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-color: var(--color-accent) var(--color-bg-secondary);
    padding: .25rem 1rem .25rem .25rem;
  }
  .cert-scroll:focus-visible { outline-offset: -2px; }
  .edu-col-label {
    margin: 0 0 1.5rem;
    font: 400 var(--text-meta)/1.6 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .edu-institution {
    margin: 0 0 .75rem;
    font: 400 var(--text-title)/1.25 var(--font-display);
  }
  .edu-meta {
    margin: 0;
    font: var(--text-meta)/1.6 var(--font-mono);
    color: var(--color-text-secondary);
  }
  .edu-degree {
    margin: 1rem 0 0;
    color: var(--color-text-primary);
  }
  .edu-additional { margin-top: 2rem; }
  .edu-additional .edu-degree { margin-top: .5rem; }
  .cert-group + .cert-group { margin-top: 1.75rem; }
  .cert-provider {
    margin: 0 0 .5rem;
    font: 500 var(--text-ui)/1.6 var(--font-body);
    color: var(--color-accent);
  }
  .cert-list { list-style: none; margin: 0; padding: 0; }
  .cert-row { padding: .75rem 0; }
  .cert-row + .cert-row { border-top: 1px solid var(--line); }
  .cert-name { color: var(--color-text-primary); }
  .cert-link { display: flex; align-items: baseline; gap: 1rem; text-decoration: none; }
  .cert-link:hover .cert-name { color: var(--color-accent); text-decoration: underline; text-underline-offset: .2em; }
  .cert-ext { margin-left: auto; color: var(--color-accent); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 47.9375em) {
    .edu { padding: 3rem 0; }
    .edu-grid { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .edu-head { margin-bottom: 2rem; }
    .edu-academic { align-content: start; }
    .cert-scroll { max-height: none; overflow: visible; scrollbar-gutter: auto; padding: 0; }
  }
</style>
