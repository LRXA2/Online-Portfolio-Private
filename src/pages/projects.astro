---
import ProjectDossier from '../components/ProjectDossier.astro';
import DescriptionText from '../components/DescriptionText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import '../styles/projects.css';
import { projectData, featuredProjects, type Category } from '../data/projects.ts';

// Build-time data guards — fail the build if the inventory is malformed.
const slugs = projectData.map((p) => p.slug);
if (new Set(slugs).size !== slugs.length) {
  throw new Error('projects.ts: duplicate slug detected');
}

type SectionDef = { id: Exclude<Category, never>; label: string; sub: string };
const SECTIONS: SectionDef[] = [
  { id: 'internship', label: 'Internship', sub: 'Sembcorp · 2024–2025' },
  ...(projectData.some(p => p.category === 'hackathon') ? [{ id: 'hackathon' as const, label: 'Hackathons', sub: '' }] : []),
  { id: 'personal', label: 'Personal', sub: '' },
  { id: 'others', label: 'Others', sub: '' },
  { id: 'year2', label: 'School · Year 2', sub: '' },
  { id: 'year1', label: 'School · Year 1', sub: '' },
];

// The first year in the display date is the project's starting year.
const startYears = new Map(projectData.map(project => {
  const year = project.year.match(/\b\d{4}\b/)?.[0];
  if (!year) throw new Error(`Missing starting year for ${project.slug}`);
  return [project.slug, year];
}));
const YEARS = [...new Set(startYears.values())].sort((a, b) => Number(b) - Number(a));
const NAV = [
  ...SECTIONS.map(s => ({ id: s.id, label: s.label })),
  ...YEARS.map(year => ({ id: `year-${year}`, label: year, hidden: true })),
];

const bySection = (id: Category) => projectData.filter((p) => p.category === id);
const pad = (n: number) => String(n).padStart(2, '0');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Projects — Aarron Loke">
  <header class="proj-hero">
    <div class="proj-hero__inner">
      <span class="proj-hero__kicker">PROJECTS · {pad(projectData.length)} BUILT</span>
      <h1 class="proj-hero__title">What I’ve built.</h1>
      <p class="proj-hero__intro">
        Internship work, personal builds, hackathons, and coursework.
      </p>
      <nav class="project-bookmarks" aria-label="Highlighted projects"><span>Highlights</span>{featuredProjects.map(p => <a href={`#${p.slug}`}>{p.name} <span aria-hidden="true">&#8600;</span></a>)}</nav>
    </div>
  </header>

  <div class="proj-shell">
    <div class="project-navigation">
      <SectionNav items={NAV} label="Jump to section" />
      <div class="project-view" hidden data-view="category">
      <div class="project-view__buttons" role="group" aria-label="Group projects by">
        <button type="button" data-project-view="category" aria-pressed="true" aria-controls="project-groups">Category</button>
        <button type="button" data-project-view="year" aria-pressed="false" aria-controls="project-groups">Year</button>
      </div>
      </div>
    </div>

    <div class="proj-layout">

      <main class="proj-main" id="project-groups">
        <!-- Category sections -->
        {SECTIONS.map((sec, si) => {
          const rows = bySection(sec.id);
          return (
            <section class="proj-section" id={sec.id} data-project-group="category">
              <div class="section-head">
                <span class="section-head__index">{pad(si + 1)}</span>
                <h2 class="section-head__kicker">{sec.label}</h2>
                {sec.sub && <span class="section-head__sub">{sec.sub}</span>}
                <span class="section-head__count">[{pad(rows.length)}]</span>
              </div>
              <ol class="proj-list">
                {rows.map((p, ri) => (
                  <li class:list={["proj-row", { "proj-row--featured": p.featured }]} id={p.slug} data-category={p.category} data-start-year={startYears.get(p.slug)}>

                    <span class="row-num">{pad(ri + 1)}</span>
                    <h3 class="row-name">
                      {p.name}
                      {p.featured && <span class="row-highlight">HIGHLIGHT</span>}
                      {p.experimental && <span class="row-exp">[EXP]</span>}
                    </h3>
                    <div class="row-meta">
                      {p.event && <span class="row-year">{p.event}</span>}
                      {p.year && <span class="row-year">{p.year}</span>}{p.status && <span class="row-year">{p.status}</span>}
                    </div>
                    <p class="row-blurb"><DescriptionText text={p.blurb} link={p.detail?.recognition} /></p>
                    <ul class="row-stack">
                      {p.stack.slice(0, 5).map((s) => <li>{s}</li>)}
                      {p.stack.length > 5 && (
                        <li class="row-stack__more">+{p.stack.length - 5}</li>
                      )}
                    </ul>
                    {p.materialsNote && <p class="row-materials">{p.materialsNote}</p>}
                    {(p.detail || p.repo || p.eventUrl || p.experienceLink) && <div class="row-actions">
                      {p.detail && <button class="row-dossier" type="button" data-open-dossier={`dossier-${p.slug}`} aria-haspopup="dialog">Open dossier <span aria-hidden="true">&#8599;</span></button>}
                      {p.repo && <a class="row-repo" href={p.repo} target="_blank" rel="noopener noreferrer">Repository <span aria-hidden="true">&#8599;</span></a>}
                      {p.eventUrl && <a class="row-repo" href={p.eventUrl} target="_blank" rel="noopener noreferrer" aria-label={`${p.event || p.name} website`}>Website <span aria-hidden="true">&#8599;</span></a>}
                      {p.experienceLink && <a class="row-experience" href={`${base}/${p.experienceLink.path}`}>{p.experienceLink.label} <span aria-hidden="true">&#8594;</span></a>}
                    </div>}
                    {p.detail && <ProjectDossier project={p} detail={p.detail} dialogOnly />}
                  </li>
                ))}
              </ol>
            </section>
          );
        })}
        {YEARS.map((year, index) => <section class="proj-section" id={`year-${year}`} data-project-group="year" hidden>
          <div class="section-head">
            <span class="section-head__index">{pad(index + 1)}</span>
            <h2 class="section-head__kicker">{year}</h2>
            <span class="section-head__count">[{pad(projectData.filter(p => startYears.get(p.slug) === year).length)}]</span>
          </div>
          <ol class="proj-list"></ol>
        </section>)}
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  import { initProjectViews } from "../lib/projectViews";
  initProjectViews();
  const shell = document.querySelector<HTMLElement>('.proj-shell')!;
  const navigation = shell.querySelector<HTMLElement>('.project-navigation')!;
  // Browser measurements stay in CSS pixels; the bar can grow with text.
  const updateNavigationHeight = () => {
    shell.style.setProperty('--project-navigation-height', `${navigation.getBoundingClientRect().height}px`);
  };
  new ResizeObserver(updateNavigationHeight).observe(navigation);
  updateNavigationHeight();
</script>
